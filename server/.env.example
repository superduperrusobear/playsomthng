# Optional: override config file location (default: config.json, then server/config.json)
# CONFIG_PATH=server/config.json

RUST_LOG=playsomthng_server=debug,tower_http=debug

# IGDB (Twitch Developer app — https://dev.twitch.tv/console/apps )
# Put these in server/.env (this file is loaded whether you run `cargo run` from server/
# or `npm run server` from the repo root).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# IGDB_APP_NAME=playsomthng
