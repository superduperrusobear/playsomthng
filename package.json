{
  "name": "somthng",
  "version": "0.1.0",
  "description": "A minimal launcher for your library",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.js",
    "dev:fresh": "node scripts/reset.js && npm run dev",
    "reset": "node scripts/reset.js",
    "reset:all": "node scripts/reset.js --all",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "icon:build": "node scripts/build-app-icon.mjs",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "server": "cargo run --manifest-path server/Cargo.toml"
  },
  "dependencies": {
    "@types/uuid": "^9.0.8",
    "aframe": "^1.7.1",
    "systeminformation": "^5.31.5",
    "three": "^0.134.0",
    "uuid": "^9.0.1",
    "vanta": "^0.5.24",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.17.19",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "lucide-react": "^0.316.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.somthng.launcher",
    "productName": "Somthng",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Somthng",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
